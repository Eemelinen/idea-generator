{
  "name": "ideaforge",
  "version": "0.1.0",
  "private": true,
  "description": "Development tooling for Ideaforge: the shared agent harness (@eemelinen/harness: feature queue, verification gates, loop driver) and commit gates. The pipeline itself is Python (see pyproject.toml).",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:py": "uv run pytest",
    "check": "pnpm format:check && pnpm harness:check && pnpm test:py",
    "harness:check": "harness check",
    "harness:feature": "harness feature",
    "harness:verify": "harness verify",
    "harness:clean-state": "harness clean-state",
    "harness:loop": "harness loop",
    "harness:report": "harness report",
    "harness:doctor": "harness doctor",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eemelinen/harness": "github:Eemelinen/harness#v0.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
