{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Agent",
      "Edit(/runs/**)",
      "Edit(/cache/**)",
      "Bash(uv run python -m ideaforge*)",
      "Bash(uv run --quiet python -m ideaforge*)",
      "Bash(uv run python scripts/*)",
      "Bash(uv run pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.guard write",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.guard bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.usage log",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.validate_file --auto",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.validate_file --auto --stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
