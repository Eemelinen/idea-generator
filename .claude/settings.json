{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Agent",
      "Edit(/runs/**)",
      "Edit(/cache/**)",
      "Bash(uv run python -m ideaforge*)",
      "Bash(uv run --quiet python -m ideaforge*)",
      "Bash(uv run python scripts/*)",
      "Bash(uv run pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(pnpm check*)",
      "Bash(pnpm format*)",
      "Bash(pnpm test:py*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm harness:*)"
    ],
    "deny": [
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Edit(uv.lock)",
      "Write(uv.lock)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.guard write",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.guard bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.usage log",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.validate_file --auto",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m ideaforge.validate_file --auto --stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "eemelinen-harness": {
      "source": {
        "source": "github",
        "repo": "Eemelinen/harness",
        "ref": "v0.3.6"
      }
    }
  },
  "enabledPlugins": {
    "harness@eemelinen-harness": true
  }
}
